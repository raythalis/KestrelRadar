FROM node:22-alpine AS ui
WORKDIR /build
COPY frontend/package*.json ./
RUN npm ci --no-audit --no-fund
COPY frontend/ ./
RUN npm run build

FROM python:3.13-alpine
WORKDIR /app
COPY backend/ ./backend/
COPY --from=ui /build/dist/ ./frontend/dist/
RUN addgroup -S radar && adduser -S -G radar radar && mkdir -p /data && chown radar:radar /data
USER radar
ENV PYTHONUNBUFFERED=1 RADAR_DB_PATH=/data/radar.db RADAR_BIND=0.0.0.0 RADAR_PORT=8765
EXPOSE 8765
CMD ["python", "-m", "backend.app"]
